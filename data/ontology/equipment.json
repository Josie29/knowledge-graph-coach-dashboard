{
  "vocabulary": "equipment",
  "source_field": "equipment_required",
  "source_file": "data/exercises.json",
  "distinct_terms": 32,
  "namespaces": "./namespaces.json",
  "description": "The 32 distinct equipment_required strings, classified and linked by a substitution graph. The substitution edges are what let the generator answer 'she has no barbell, only dumbbells and a kettlebell' with equivalents rather than an empty plan.",
  "class_vocabulary": {
    "free_weight": "Unfixed external load held or racked by the user.",
    "machine": "Fixed-path or cable-guided resistance machine, or an ergometer.",
    "band": "Elastic resistance.",
    "support_surface": "A bench, box, ball or mat that positions the body rather than resisting it.",
    "implement": "A ballistic or carried object.",
    "suspension": "Bodyweight suspended from an anchor.",
    "fixture": "Fixed environmental structure.",
    "soft_tissue_tool": "Tool for myofascial / soft-tissue work."
  },
  "substitution_semantics": {
    "predicate": "SUBSTITUTABLE_FOR",
    "degree": {
      "equivalent": "Swap changes nothing meaningful about the stimulus or the safety profile.",
      "close": "Same pattern trainable, minor change to load range, stability demand or grip.",
      "partial": "Only some of the source equipment's uses are covered; the generator must re-check the exercise's pattern."
    },
    "note": "Directional. 'A SUBSTITUTABLE_FOR B' means A can stand in for B. Not automatically symmetric: a dumbbell substitutes for a barbell at moderate loads, but a barbell is a poor substitute for a dumbbell in a unilateral exercise."
  },
  "ontology_grounding": {
    "headline": "0 of 32 equipment terms have an exact match in any published ontology. 31 of 32 carry a skos:broader link to an OPE category; 1 (Wall) is declined outright.",
    "why": "OPE models equipment as eight abstract categories and ships zero named individuals - there is no Dumbbell, Barbell, Kettlebell, bench, band, mat or machine class anywhere in it. Verified by enumerating all 634 OPE classes and grepping the downloaded OWL. COPPER is the same story from the other direction: it declares an abstract copper:1058 Equipment class reached through copper:1061 needsEquipment, with no concrete gym implements.",
    "consequence": "The equipment nodes themselves are minted in the kgc: namespace. The ontologies contribute the category above each node and the property that attaches it to an exercise (ope:utilizesEquipment), not the node.",
    "ope_categories_used": [
      "ope:ConsumerEquipment",
      "ope:WieldedPersonalGearEquipment",
      "ope:StationaryMachineEquipment"
    ],
    "ope_categories_unused": {
      "ope:RegulatedEquipment": "Nothing in a home or commercial gym catalog is regulated medical equipment.",
      "ope:WearablePersonalGearEquipment": "No wearable appears in the catalog.",
      "ope:MonitorEquipment": "No heart-rate strap, watch or sensor appears in the catalog. Would become relevant if biomarker capture were modelled."
    }
  },
