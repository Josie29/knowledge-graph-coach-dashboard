# Copy to .env and fill in. docker-compose reads this file automatically.

# Required for the AI features (issues #8+). The scaffold runs without it.
ANTHROPIC_API_KEY=

# claude-haiku-4-5 while validating (cheapest), claude-opus-5 for demo runs.
# Also accepts claude-sonnet-5.
ANTHROPIC_MODEL=claude-haiku-4-5

# Neo4j password used by both the neo4j and api services.
NEO4J_PASSWORD=password
