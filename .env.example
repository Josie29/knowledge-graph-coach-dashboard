# Copy to .env and fill in. docker-compose reads this file automatically.

# Required for the AI features (issues #8+). The scaffold runs without it.
ANTHROPIC_API_KEY=

# claude-haiku-4-5 while validating (cheapest), claude-opus-5 for demo runs.
# Also accepts claude-sonnet-5.
ANTHROPIC_MODEL=claude-haiku-4-5

# Neo4j password used by both the neo4j and api services.
NEO4J_PASSWORD=password

# Password for the local trace-store Postgres. Nothing else uses it.
POSTGRES_PASSWORD=traces

# Tracing is on by default and needs no account or keys. Open the Traces tab
# in the web app to read it.
# Set false to record timings, tokens, and cost but no prompt/completion text.
OBS_CAPTURE_CONTENT=true
# Traces older than this are deleted; the sweep runs as spans are written.
OBS_RETENTION_DAYS=7
